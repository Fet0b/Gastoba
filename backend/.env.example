# URL do banco no formato do SQLAlchemy. Padrão: arquivo gastobs.db em backend/.
GASTOBA_URL_BANCO=sqlite:///./gastobs.db

# Origens (frontends) que podem chamar a API pelo navegador, em formato JSON.
# Padrão: o servidor de desenvolvimento do Vite.
GASTOBA_ORIGENS_PERMITIDAS=["http://localhost:5173"]

# Hosts (cabeçalho Host) que a API atende, em formato JSON. Protege contra DNS rebinding.
# Nunca use "*": a API recusa.
GASTOBA_HOSTS_PERMITIDOS=["localhost", "127.0.0.1"]

# Nome do usuário padrão herdado (dono dos dados gravados antes do login); só o comando
# administrativo `criar-usuario --assumir-dados-do-padrao` o usa.
GASTOBA_NOME_USUARIO_PADRAO=Usuário

# Permite o auto-cadastro pela API (POST /auth/cadastro). Padrão: false (cadastro fechado;
# os usuários são criados pelo comando administrativo).
GASTOBA_CADASTRO_ABERTO=false

# Validade da sessão de login, em horas (inteiro maior que zero), sem renovação.
GASTOBA_DURACAO_DA_SESSAO_HORAS=12

# Marca o cookie de sessão como Secure (só enviado por HTTPS). Padrão: true.
# Use false apenas no servidor caseiro acessado por HTTP dentro da VPN.
GASTOBA_COOKIE_SEGURO=true

# Falhas de login aceitas por e-mail e por IP em 15 minutos; a seguinte recebe 429.
# O contador fica em memória: vale para uma réplica só da API. Padrão: 5.
GASTOBA_TENTATIVAS_DE_LOGIN=5

# De quanto em quanto tempo (minutos) a API gera os gastos e ganhos das recorrências
# vencidos, além de uma rodada ao subir. 0 desliga a tarefa. Padrão: 60.
GASTOBA_INTERVALO_DE_RECORRENCIAS_MINUTOS=60

# Importação bancária pela Pluggy (conector MeuPluggy), só para a pessoa dona. Desligada sem
# as quatro primeiras. Os valores reais ficam só no .env, nunca no repositório.
# Passo a passo: plans/2026-10-13_importacao-pluggy-meupluggy.md.
# GASTOBA_PLUGGY_CLIENT_ID=
# GASTOBA_PLUGGY_CLIENT_SECRET=
# itemId de cada banco conectado no Meu Pluggy (copiado do Dashboard), em formato JSON.
# GASTOBA_PLUGGY_ITEM_IDS=["<itemId>"]
# E-mail da única pessoa que usa a importação (o plano gratuito é de uso pessoal).
# GASTOBA_PLUGGY_EMAIL_DO_DONO=
# De quanto em quanto tempo (horas) a API busca transações novas; 0 desliga. Padrão: 6.
# GASTOBA_PLUGGY_INTERVALO_HORAS=6
# Na primeira busca de uma conta, quantos dias para trás. Padrão: 30.
# GASTOBA_PLUGGY_DIAS_INICIAIS=30

# GASTOBA_SENHA_INICIAL: senha do comando administrativo `criar-usuario`, lida só do
# ambiente do comando (nunca deste arquivo). Sem ela, o comando pergunta a senha sem eco.
# Não guarde senha real aqui.
