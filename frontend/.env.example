# Variáveis do frontend (o Vite só expõe ao navegador as que começam com VITE_).
# Nenhuma delas é segredo: tudo que vai para o navegador é público.
# Os valores de desenvolvimento ficam em .env.development (versionado); o Vite
# não lê este arquivo, que serve só de documentação.

# Endereço da API do Gastoba. Padrão: http://localhost:8000
# Use localhost, não 127.0.0.1: o cookie de sessão é SameSite=Strict e o navegador
# só o envia se a página (http://localhost:5173) e a API forem do mesmo site;
# com 127.0.0.1 aqui, toda chamada volta 401.
VITE_API_URL=http://localhost:8000

# "true" faz o `npm run dev` usar a API simulada em memória (sem backend).
# Para falar com o backend real, crie .env.development.local (ignorado pelo git)
# com VITE_USAR_SIMULACAO=false. A simulação nunca entra no build de produção.
# A simulação começa sem sessão; entre com o usuário de exemplo, que só existe
# nela (não é segredo nem vale no backend real):
#   e-mail: voce@exemplo.com
#   senha:  senha-de-exemplo-123
VITE_USAR_SIMULACAO=true
